{
  "name": "texas-holdem-poker",
  "version": "1.0.0",
  "description": "局域网德州扑克游戏",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/initDatabase.js",
    "reset-db": "node scripts/initDatabase.js reset",
    "migrate-db": "node scripts/migrateDb.js",
    "test:pots": "node scripts/testPots.js",
    "test:rebuy": "node scripts/testRebuy.js",
    "setup-mongo": "powershell -ExecutionPolicy Bypass -File scripts/setup-mongo.ps1",
    "db": "node scripts/mongo.js start",
    "db:status": "node scripts/mongo.js status",
    "db:stop": "node scripts/mongo.js stop"
  },
  "dependencies": {
    "dgram": "^1.0.1",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.5",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.4"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "multiplayer",
    "websocket"
  ],
  "author": "Poker Game Developer",
  "license": "MIT"
